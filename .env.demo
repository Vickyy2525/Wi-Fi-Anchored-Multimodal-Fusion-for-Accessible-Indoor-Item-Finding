# Demo-stable settings for presentation week.
# Usage: cp .env.demo .env   (backup your current .env first if needed)
# Does NOT include HF_TOKEN — copy your own token into .env if required.

VLM_BACKEND=ollama

# Neo4j-first memory graph (demo default)
GRAPH_MODE=neo4j_first
STRICT_NEO4J=true
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# Auto process completed 5-minute windows
AUTO_WINDOW_JOB=true
AUTO_WINDOW_INTERVAL_SEC=300

# Wi-Fi + IMU: phase0 = time anchors (stable for demo)
WIFI_IMU_FUSION_MODE=phase0

# Dedupe v2 knobs
DEDUPE_TEMPORAL_SEC=3
DEDUPE_SIM_THRESHOLD=0.93
DEDUPE_BUCKET_KEEP=2
