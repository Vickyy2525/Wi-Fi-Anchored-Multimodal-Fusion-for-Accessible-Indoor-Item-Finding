# ============================================================
# 多模態空間記憶尋物系統 — 環境變數範本
# 使用方式：複製此檔為 .env，再依需求修改
#   cp .env.example .env
# ============================================================

# --- VLM 推理後端 (必填) ---
# 可選值：mock | ollama | huggingface
VLM_BACKEND=mock

# --- 模式 A：Ollama 本地推理 ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llava
OLLAMA_TIMEOUT=120

# --- 模式 C：Hugging Face 雲端推理 ---
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
HF_MODEL_ID=llava-hf/llava-1.5-7b-hf
HF_TIMEOUT=120

# --- 即時 Ingest Server ---
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# --- 記憶圖模式 ---
# networkx    : 僅 session 內 NetworkX（預設）
# dual_write  : NetworkX + 持久化 GraphStore（Neo4j 或 File），並做一致性比對
# neo4j_first : 查詢以 Neo4j 為唯一真實來源（NetworkX 僅 session scratch）
GRAPH_MODE=neo4j_first

# --- Neo4j ---
# neo4j_first / STRICT_NEO4J=true 時必填且必須連得上
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
STRICT_NEO4J=true

# --- Auto window scheduler ---
AUTO_WINDOW_JOB=true
AUTO_WINDOW_INTERVAL_SEC=300

# --- Dedupe v2 tuning ---
DEDUPE_TEMPORAL_SEC=3
DEDUPE_SIM_THRESHOLD=0.93
DEDUPE_BUCKET_KEEP=2

# --- Wi-Fi + IMU fusion ---
# phase0: anchors only, phase1: lightweight drift correction (needs enough repeated BSSID)
WIFI_IMU_FUSION_MODE=phase0
WIFI_FUSION_MIN_REPEAT=3
WIFI_FUSION_MIN_CONSTRAINTS=4

# --- Care notifications (optional) ---
# Email alerts to emergency contacts
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=your@gmail.com

# SMS via Twilio (optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
